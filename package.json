{
  "name": "dunkelmann",
  "version": "2.0.0",
  "description": "Dunkelmann Discord Bot & Web Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.cjs",
    "start:ptero": "bash start.sh",
    "install:all": "bash install.sh",
    "dev": "ts-node index.ts",
    "pm2": "npm run build && pm2 start ecosystem.config.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@sapphire/framework": "^5.2.1",
    "axios": "^1.12.2",
    "discord.js": "^14.26.4",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "opusscript": "^0.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.10.6",
    "@types/passport": "^1.0.16",
    "@types/passport-discord": "^0.1.11"
  },
  "overrides": {
    "tar": "^7.5.3",
    "glob": "^11.0.3",
    "cross-spawn": "^7.0.6",
    "brace-expansion": "^2.0.2",
    "form-data": "^4.0.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "@discordjs/opus@0.10.0": true
  }
}
