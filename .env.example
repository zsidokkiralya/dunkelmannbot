# A mar letezo .env fajlt ne ird felul.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PORT=3000
BASE_URL=http://localhost:3000
# HTTPS mogotti egyetlen megbizhato reverse proxy eseten true.
# Kozvetlen HTTP kiszolgalasnal false.
TRUST_PROXY=false
# Uresen biztonsagos, veletlen titkok keszulnek minden inditaskor.
# Kulon bot/web folyamatnal ugyanazt a BOT_API_SECRET erteket kell megadni.
SESSION_SECRET=
BOT_API_SECRET=
BOT_API_PORT=20022
DEV_IDS=
VIRUSTOTAL_API_KEY=
BEATCLOUD_API_KEY=
# Csak pontos hostnevek, vesszovel elvalasztva; protokoll es utvonal nelkul.
# A kulcsot mas domain nem kaphatja meg.
BEATCLOUD_ALLOWED_HOSTS=
